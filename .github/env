# Shared environment variables for every workflow that needs them.
# Each top-level workflow's first job step (after `actions/checkout`)
# loads this file with `cat .github/env >> "$GITHUB_ENV"`. The format
# is `KEY=VALUE` per line (no shell quoting / interpolation) which is
# what `$GITHUB_ENV` consumes verbatim.
#
# `MISE_VERSION` sets every workflow's mise install. Renovate bumps it
# (see the regex manager in renovate.json5).
MISE_VERSION=v2026.11.6
#
# `TOOLR_VERSION` is the toolr binary .github/actions/setup-toolr installs.
# It must match the `aqua:s0undt3ch/ToolR` pin in mise.toml and the `toolr-py`
# in tools/uv.lock, or the binary can emit a runner schema the tools venv
# rejects. Renovate's "toolr release" group bumps all three together, and
# tests/workflows/test_dogfood_toolr_pin.py fails when they drift.
TOOLR_VERSION=0.35.1
